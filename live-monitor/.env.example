# ========================================================================
# LIVE MONITOR SERVER - ENVIRONMENT VARIABLES (STRICTLY READ-ONLY DB)
# ========================================================================

# Server Port (Dokku sets this automatically to 3000 or 5000)
PORT=3000

# Google Gemini API Key (Required for Multimodal Live streaming & trade extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Default: gemini-3.8-live)
GEMINI_MODEL=gemini-3.8-live

# Supabase Credentials (STRICTLY READ-ONLY: Only used to SELECT active channels)
# You can safely use either your SUPABASE_ANON_KEY or SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# YouTube Data API Key (Optional: system automatically falls back to zero-quota scraping if not set)
YOUTUBE_API_KEY=

# Polling Interval in Seconds (How often active channels are checked for live broadcasts)
POLL_INTERVAL_SECONDS=60

# Max Concurrent Streams (How many simultaneous livestreams to monitor)
MAX_CONCURRENT_STREAMS=3

# Pushover Notifications (Instant mobile/watch push alerts)
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
PUSHOVER_DEVICE=
PUSHOVER_EMERGENCY=false
PUSHOVER_PRIORITY=1
PUSHOVER_SOUND=

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Cookies (Optional: for bypassing bot verification/429. Can be raw Netscape text or Base64 string)
YOUTUBE_COOKIES=
COOKIES_FILE=

# Debounce & Verbosity
DEBOUNCE_MINUTES=15
VERBOSE=false
