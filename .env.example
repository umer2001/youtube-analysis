# Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenRouter Configuration (for transcript fallback: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BATCH_MODEL=google/gemini-2.5-flash

# YouTube Data API v3 Key (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pushover Push Notifications (https://pushover.net/)
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
PUSHOVER_DEVICE=
# Set to 'true' or priority=2 for non-stop repeating alarm until acknowledged
PUSHOVER_EMERGENCY=false
PUSHOVER_PRIORITY=1
# Alarm frequency (seconds) until acknowledged (min 30s)
PUSHOVER_RETRY=30
# Duration (seconds) before repeating stops if unacknowledged (default 1800s = 30m)
PUSHOVER_EXPIRE=1800
# Pushover sound (e.g. siren, cashregister, incoming, persistent)
# PUSHOVER_SOUND=siren

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webshare Rotating Proxies for Edge Function Transcript Extraction (Optional, comma-separated)
WEBSHARE_PROXIES=
